DATABASE_URL="file:../data/workbench.db"
# Server only. Keep your real key in .env.local; never commit it.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_REASONING_EFFORT="high"
# Local development needs no login. Production always requires the private account.
PRIVATE_CLOUD="0"
APP_URL=""
PRIVATE_OWNER_EMAIL=""
BETTER_AUTH_SECRET=""
# Linux container: /app/data. Omit to use this project's data directory locally.
DATA_DIR=""

# Optional: React Bits Pro registry installs; set the real key in .env.local only.
REACTBITS_LICENSE_KEY=
